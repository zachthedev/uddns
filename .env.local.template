# Local deployment configuration. Copy to .env.local (gitignored). bun loads it
# for `bun run deploy`; wrangler itself authenticates through `wrangler login`.
# In CI the same names are secrets on the production environment.

CLOUDFLARE_ACCOUNT_ID=REPLACE_WITH_YOUR_ACCOUNT_ID

# Optional: attach a custom domain. Without it the worker is served at its
# workers.dev URL.
# CUSTOM_DOMAIN=ddns.example.com

# Optional: synced to the worker as a secret on every deploy when present.
# 32 hexadecimal characters; `openssl rand -hex 16` makes one.
# ACCESS_KEY=REPLACE_WITH_32_HEX_CHARACTERS