{
  "name": "uddns",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun x --no-install wrangler dev",
    "start": "bun x --no-install wrangler dev",
    "deploy": "bun scripts/deploy.ts",
    "cf-typegen": "bun x --bun --no-install wrangler types --config wrangler.jsonc --env-file .dev.vars.template",
    "cf-typegen:check": "rm -f worker-configuration.d.ts && bun run cf-typegen && git diff --no-ext-diff --exit-code -- worker-configuration.d.ts",
    "test": "NO_PROXY=$NO_PROXY,localhost,127.0.0.1,::1 bun x --bun --no-install vitest",
    "test:run": "NO_PROXY=$NO_PROXY,localhost,127.0.0.1,::1 bun x --bun --no-install vitest run",
    "test:coverage": "NO_PROXY=$NO_PROXY,localhost,127.0.0.1,::1 bun x --bun --no-install vitest run --coverage",
    "test:watch": "NO_PROXY=$NO_PROXY,localhost,127.0.0.1,::1 bun x --bun --no-install vitest watch",
    "lint": "bun x --bun --no-install eslint --config eslint.config.ts . --max-warnings=0",
    "lint:fix": "bun x --bun --no-install eslint --config eslint.config.ts . --fix",
    "format": "bun x --bun --no-install prettier --config .prettierrc --no-editorconfig --ignore-path .prettierignore --write .",
    "format:check": "bun x --bun --no-install prettier --config .prettierrc --no-editorconfig --ignore-path .prettierignore --check .",
    "typecheck": "bun x --bun --no-install tsc --noEmit -p tsconfig.json && bun x --bun --no-install tsc --noEmit -p tests/tsconfig.json && bun x --bun --no-install tsc --noEmit -p scripts/tsconfig.json",
    "audit": "bun audit --audit-level=high",
    "check": "bun --no-env-file scripts/check.ts",
    "check:quick": "bun --no-env-file scripts/check.ts --quick",
    "check:rows": "bun --no-env-file scripts/check.ts --rows",
    "prepare": "bun ./node_modules/lefthook/bin/index.js install"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.13",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-istanbul": "4.1.11",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "jiti": "2.7.0",
    "lefthook": "2.1.14",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11",
    "wrangler": "4.135.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "dependencies": {
    "cloudflare": "7.1.0"
  }
}
