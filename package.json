{
	"name": "uddns",
	"version": "1.0.2",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.2",
	"scripts": {
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"deploy": "bun scripts/deploy.ts",
		"setup": "bun scripts/setup.ts",
		"cf-typegen": "wrangler types",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest watch",
		"lint": "eslint . --max-warnings=0",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "bun node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.json && bun node_modules/@typescript/native/bin/tsc --noEmit -p tests/tsconfig.json && bun node_modules/@typescript/native/bin/tsc --noEmit -p scripts/tsconfig.json",
		"check": "bun run typecheck && bun run lint && bun run format:check && bun scripts/check-cooldown.ts",
		"check:all": "bun run check && bun run test:run",
		"prepare": "lefthook install"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "1.1.13",
		"@eslint/js": "^10.0.0",
		"@types/bun": "1.4.2",
		"@types/node": "26.6.2",
		"@typescript/native": "npm:typescript@7.0.2",
		"@vitest/coverage-istanbul": "4.1.11",
		"comment-json": "5.0.0",
		"eslint": "10.11.0",
		"eslint-config-prettier": "10.1.8",
		"jiti": "^2.7.0",
		"lefthook": "^2.1.14",
		"prettier": "3.9.8",
		"typescript": "6.0.3",
		"typescript-eslint": "8.70.0",
		"vitest": "4.1.11",
		"wrangler": "4.135.0"
	},
	"dependencies": {
		"cloudflare": "7.1.0"
	}
}
